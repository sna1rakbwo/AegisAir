{
  "additionalProperties": false,
  "description": "Frozen, auditable C3-Admission decision for one control cycle.\n\nThe decision changes only mission-level passage order and hold goals.  It\nnever contains a direct actuator command and therefore cannot bypass RA.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "step": {
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "coordination_mode": {
      "enum": [
        "normal",
        "admission_pending",
        "pass",
        "hold",
        "release"
      ],
      "title": "Coordination Mode",
      "type": "string"
    },
    "admission_triggers": {
      "items": {
        "enum": [
          "conflict_zone",
          "reserve_low",
          "predicted_rho_low"
        ],
        "type": "string"
      },
      "title": "Admission Triggers",
      "type": "array"
    },
    "authorized_drone_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Authorized Drone Ids",
      "type": "array"
    },
    "held_drone_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Held Drone Ids",
      "type": "array"
    },
    "frozen_hold_goals": {
      "additionalProperties": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Frozen Hold Goals",
      "type": "object"
    },
    "hold_enter_steps": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Hold Enter Steps",
      "type": "object"
    },
    "conflict_zone_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Zone Id"
    },
    "ra_vetoed": {
      "default": false,
      "title": "Ra Vetoed",
      "type": "boolean"
    },
    "authority_source": {
      "enum": [
        "c3_rule",
        "fallback"
      ],
      "title": "Authority Source",
      "type": "string"
    },
    "timestamp_ms": {
      "minimum": 0,
      "title": "Timestamp Ms",
      "type": "integer"
    }
  },
  "required": [
    "step",
    "coordination_mode",
    "authority_source",
    "timestamp_ms"
  ],
  "title": "CoordinationAdmissionDecision",
  "type": "object"
}
